# Frontend env vars (CRA — must be prefixed REACT_APP_)
#
# Backend URL. In deployed Vercel builds this is unused because vercel.json
# rewrites /api/* to the backend; the resolver in src/lib/api.js falls back
# to same-origin. Keep it set for local dev (`yarn start` on :3000 → :8001).
REACT_APP_BACKEND_URL=http://localhost:8001

# Don't ship source maps to production users.
GENERATE_SOURCEMAP=false

# --- Analytics & error reporting ---
#
# PostHog is initialized in src/index.js after analytics consent is granted.
REACT_APP_POSTHOG_KEY=phc_YOUR_KEY_HERE
REACT_APP_POSTHOG_HOST=https://YOUR_POSTHOG_HOST

# Sentry — wired in src/index.js with host-based DSN selection so errors land
# in the right project per surface. EU region (sentry.io · org "aiporate").
# Init is gated: if neither DSN is set, the SDK stays dormant.
REACT_APP_SENTRY_DSN_LEADER_OS=https://YOUR_KEY@YOUR_ORG.ingest.de.sentry.io/YOUR_PROJECT
REACT_APP_SENTRY_DSN_LEADER_CHECK=https://YOUR_KEY@YOUR_ORG.ingest.de.sentry.io/YOUR_PROJECT
REACT_APP_SENTRY_ENV=production

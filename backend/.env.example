# Backend env vars (/app/backend/.env on the deployed host)

# --- Persistence ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=leadership_os

# --- LLM + Voice ---
EMERGENT_LLM_KEY=                    # GPT-5.2 + Whisper + Image Gen (Emergent Universal Key)
ELEVENLABS_API_KEY=                  # Voice cloning for Wlad + Challenger voices

# --- CORS ---
# Comma-separated list of allowed origins for browser requests carrying
# credentials. Set explicitly in production — never leave at "*" once the
# real domains are live.
# CORS_ORIGINS=https://leaderos.de,https://www.leaderos.de,https://leadercheck.de,https://www.leadercheck.de,https://leader-os.de,https://www.leader-os.de,https://leader-check.de,https://www.leader-check.de
CORS_ORIGINS=

# --- Frontend host (used by magic-link emails to build the verify URL) ---
# Set per Emergent project so cross-tenant logins return to the right tier.
# leaderos     project: FRONTEND_BASE_URL=https://leaderos.de
# leadercheck  project: FRONTEND_BASE_URL=https://leadercheck.de
FRONTEND_BASE_URL=

# --- Payments (Stripe) ---
# Production cutover: replace sk_test_* with sk_live_* and register the
# webhook at https://leaderos.de/api/webhook/stripe.
# STRIPE_WEBHOOK_SECRET (whsec_*) is REQUIRED for defense-in-depth signature
# validation. Get it from Stripe Dashboard → Developers → Webhooks → the
# endpoint you registered → "Signing secret". Without it the webhook handler
# logs a warning and relies on the integrations wrapper alone.
STRIPE_API_KEY=sk_test_emergent
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=reminders@leader-os.de
# Optional inbox for enterprise lead notifications; falls back to SENDER_EMAIL.
ENTERPRISE_LEAD_EMAIL=sales@leader-os.de

# --- Cron auth (defense in depth) ---
# Optional shared secret for /api/cron/* endpoints. When set, callers must
# send the matching value in the X-Cron-Secret header. Unset = endpoints
# stay open (backwards compatible). Generate with: `openssl rand -hex 32`.
# Also add the same value as the GitHub Actions repo secret CRON_SHARED_SECRET
# so the scheduled workflow keeps working.
CRON_SHARED_SECRET=

# --- Supabase (WladHub bi-directional sync) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
